# Port the API listens on
PORT=8787

# Where the webapp runs (for CORS). Comma-separate multiple origins.
CORS_ORIGIN=http://localhost:5173

# Supabase — used ONLY to verify the caller's access token (getUser).
# Same project as the webapp. The publishable/anon key is enough; no service key.
SUPABASE_URL=https://omupuwpmywcuzsykabbk.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_bt-kpI9FopyEF1WKk3OCOA_nET8ehGw

# Server-only secret (Dashboard → Project Settings → API → service_role key).
# Enables persistence to the `projects` table + Supabase Storage (per-user
# isolation, signed URLs, history). Without it the API falls back to an
# in-memory store + local-disk delivery (no history across restarts).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=videos
SIGNED_URL_TTL=3600

# Set to "true" to allow unauthenticated requests (handy for local dev without a token).
ALLOW_ANON=false

# Pipeline mode:
#   real  → actually run: CrewAI flow → Remotion render → audio master
#   mock  → simulate the stages and return the last real render (renderer/out/final.mp4)
#           so the API + UI can be exercised without Ollama/GPU/render time.
PIPELINE_MODE=mock
