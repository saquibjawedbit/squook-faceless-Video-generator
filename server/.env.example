# Port the API listens on
PORT=8787

# Where the webapp runs (for CORS). Comma-separate multiple origins.
CORS_ORIGIN=http://localhost:5173

# Supabase — used ONLY to verify the caller's access token (getUser).
# Same project as the webapp. The publishable/anon key is enough; no service key.
SUPABASE_URL=https://omupuwpmywcuzsykabbk.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_bt-kpI9FopyEF1WKk3OCOA_nET8ehGw

# Server-only secret (Dashboard → Project Settings → API → service_role key).
# Enables persistence to the `projects` table + Supabase Storage (per-user
# isolation, signed URLs, history). Without it the API falls back to an
# in-memory store + local-disk delivery (no history across restarts).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=videos
SIGNED_URL_TTL=3600

# Set to "true" to allow unauthenticated requests (handy for local dev without a token).
ALLOW_ANON=false

# Pipeline mode:
#   real  → actually run: CrewAI flow → Remotion render → audio master
#   mock  → simulate the stages and return the last real render (renderer/out/final.mp4)
#           so the API + UI can be exercised without Ollama/GPU/render time.
PIPELINE_MODE=mock

# Stock-footage search for the editor's "Replace footage" panel. Both are free
# to obtain and optional — leave a key blank to disable that provider (the other
# still works; if both are blank only Upload / Paste-URL are available).
#   Pexels  → https://www.pexels.com/api/  (header-auth video search)
#   Pixabay → https://pixabay.com/api/docs/ (video search)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Landing page → video ("From landing page" mode). Runs the repo's
# landing-page-video skill in a headless Claude Code session, which drives
# HyperFrames (capture → storyboard → frames → render). Needs the `claude` CLI
# signed in, Node 22+, and ffmpeg. PIPELINE_MODE=mock skips all of it.
#   CLAUDE_BIN            → path to the claude CLI (default: claude on PATH)
#   LANDING_CLAUDE_MODEL  → optional model override, e.g. claude-opus-5-5
#   LANDING_TIMEOUT_MIN   → kill a run that takes longer than this (default 60)
CLAUDE_BIN=
LANDING_CLAUDE_MODEL=
LANDING_TIMEOUT_MIN=60

# Run the landing-page agent on Cloudflare Workers AI instead of Anthropic.
# Set both to enable; the server runs a local adapter and the agent never
# sees the token. Kimi K2.6 needs the Workers Paid plan.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_MODEL=@cf/moonshotai/kimi-k2.6
