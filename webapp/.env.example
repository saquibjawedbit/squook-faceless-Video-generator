# Copy this file to .env.local and fill in your Supabase project values.
# Project URL + anon (public) key: Supabase dashboard → Project Settings → API.
# Both are safe to expose in a browser bundle; Row-Level Security protects data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
